      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/quota-guard/guard.mjs inspect",
            "timeout": 15,
            "statusMessage": "Verification anti-boucle de sondage..."
          }
        ]
      }
    ]
  }
}
