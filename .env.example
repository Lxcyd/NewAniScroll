CLIENT_ID="get the id from here https://anilist.co/settings/developer"
CLIENT_SECRET="get the secret from here https://anilist.co/settings/developer"
GRAPHQL_ENDPOINT="https://graphql.anilist.co"

NEXTAUTH_SECRET='run this cmd in your bash terminal (openssl rand -base64 32) with no bracket, and paste it here'
NEXTAUTH_URL="for development use http://localhost:3000/ and for production use your domain url"
DISQUS_SHORTNAME='put your disqus shortname here (optional)'
# ADMIN_USERNAME="Your AniList account username"

## Use any postgresql db, or supabase for free options
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# If you don't want to use redis, just comment the REDIS_URL (press ctrl + / on windows or cmd + / on mac)
REDIS_URL="redis://user:password@host:port"

# Optional anime-proxy (https://github.com/Vertixx01/anime-proxy) — deploy your
# own instance on Vercel/Cloudflare/Railway and set the URL here. When configured,
# Vidmoly extraction routes through the proxy's IP pool, bypassing per-IP bans
# that block server-side fetches from the dev server.
# ANIME_PROXY_URL="https://your-anime-proxy.vercel.app"

# Optional CoorenLabs backend (https://github.com/CoorenLabs). Provides AnimePahe
# and AnimeKai sources. Without this, those servers stay hidden in the selector.
# COOREN_API_URL="https://your-cooren-deployment.example.com"
# Cloudflare Worker URL used for the HLS / segment proxy. When set, the
# client builds proxy URLs against this Worker instead of the in-tree
# /api/v2/proxy/m3u8 endpoint — moves all .ts segment bandwidth off Vercel
# (unmetered on Workers, automatic edge caching). See worker/README.md for
# the deploy steps. Leave unset for local dev to use the Vercel proxy.
# NEXT_PUBLIC_PROXY_BASE="https://aniscroll-proxy.<your-account>.workers.dev"

# Optional dedicated Turso DB for the anime_fanarts table. When set, fanart
# reads (including the SSR loadFanarts call on the info page) and the
# classify/refresh crons all run against this database, isolating their row-
# read budget and traffic from the hot anime metadata path. Leave unset to
# keep everything on TURSO_DATABASE_URL.
# TURSO_FANARTS_DATABASE_URL="libsql://your-fanarts-db.turso.io"
# TURSO_FANARTS_AUTH_TOKEN="..."
