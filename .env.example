CLIENT_ID="get the id from here https://anilist.co/settings/developer"
CLIENT_SECRET="get the secret from here https://anilist.co/settings/developer"
GRAPHQL_ENDPOINT="https://graphql.anilist.co"

NEXTAUTH_SECRET='run this cmd in your bash terminal (openssl rand -base64 32) with no bracket, and paste it here'
NEXTAUTH_URL="for development use http://localhost:3000/ and for production use your domain url"
DISQUS_SHORTNAME='put your disqus shortname here (optional)'
# ADMIN_USERNAME="Your AniList account username"

## Use any postgresql db, or supabase for free options
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# If you don't want to use redis, just comment the REDIS_URL (press ctrl + / on windows or cmd + / on mac)
# NOTE: REDIS_URL is REQUIRED for the "Watch 2gether" feature — rooms, sync,
# chat and presence all live in Redis (no Vercel KV / database is used).
# In prod the caching client prefers UPSTASH_REDIS_REST_URL/_TOKEN (HTTPS, port
# 443 — native 6379 is blocked outbound), falling back to deriving them from
# REDIS_URL. Set the REST pair to point at the LIVE Upstash DB.
REDIS_URL="redis://user:password@host:port"
# UPSTASH_REDIS_REST_URL="https://<db>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="<rest-token from the Upstash console REST API tab>"

# ── tools/usage-monitor (daily Upstash/Vercel diagnostic) — all optional ──
# Upstash management API (enables the daily-requests chart + free-cap projection):
# UPSTASH_EMAIL="you@example.com"
# UPSTASH_API_KEY="<console.upstash.com/account/api → 'Developer API' tab → Create API key>"
# UPSTASH_DATABASE_ID="<optional; auto-discovered otherwise>"
# Vercel API (enables deployment correlation in the report):
# VERCEL_TOKEN="<vercel.com → Account Settings → Tokens>"
# VERCEL_PROJECT_ID="aniscroll"
# VERCEL_TEAM_ID="<optional, for team-scoped projects>"

# Optional CoorenLabs backend (https://github.com/CoorenLabs). Provides AnimePahe
# and AnimeKai sources. Without this, those servers stay hidden in the selector.
# COOREN_API_URL="https://your-cooren-deployment.example.com"
# Cloudflare Worker URL used for the HLS / segment proxy. When set, the
# client builds proxy URLs against this Worker instead of the in-tree
# /api/v2/proxy/m3u8 endpoint — moves all .ts segment bandwidth off Vercel
# (unmetered on Workers, automatic edge caching). See worker/README.md for
# the deploy steps. Leave unset for local dev to use the Vercel proxy.
# The custom domain is REQUIRED for the Worker's edge cache to work — the
# Cache API is a no-op on *.workers.dev. Prod points at proxy.aniscroll.com.
# NEXT_PUBLIC_PROXY_BASE="https://proxy.aniscroll.com"

# (The per-episode score grid on the Scores tab uses Jikan / MyAnimeList, which
#  needs no API key — so there's nothing to configure here for it.)

# Optional dedicated Turso DB for the anime_fanarts table. When set, fanart
# reads (including the SSR loadFanarts call on the info page) and the
# classify/refresh crons all run against this database, isolating their row-
# read budget and traffic from the hot anime metadata path. Leave unset to
# keep everything on TURSO_DATABASE_URL.
# TURSO_FANARTS_DATABASE_URL="libsql://your-fanarts-db.turso.io"
# TURSO_FANARTS_AUTH_TOKEN="..."

# TMDB API key (v3 auth, free: themoviedb.org/settings/api). Artwork only:
#   - hero/backdrop key art (native 1280x720+, versus AniList's 1900x400 crop)
#   - title logos, where fanart.tv has none
#   - episode stills, ONLY for episodes ani.zip left empty — never overriding it
# Selection rules are Hayase's (lib/tmdb/pick.ts); results are cached 30 days
# in Turso (tmdb_images_cache) so the homepage never pays the fetch twice.
#
# Limits: no quota and no per-key cap. ~50 req/s per IP on api.themoviedb.org;
# image.tmdb.org caps simultaneous connections (20/IP), which the visitor's
# browser spends, not us.
#
# ATTRIBUTION IS CONTRACTUAL: /en/sources must keep the verbatim disclaimer
# "This product uses the TMDB API but is not endorsed or certified by TMDB."
# Unset, every TMDB path returns null and the previous sources are used.
# TMDB_API_KEY="..."
